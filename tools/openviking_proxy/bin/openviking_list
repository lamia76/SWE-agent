#!/usr/bin/env python3
"""List resources in an OpenViking path."""
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy, parse_bool


def main():
    uri = sys.argv[1] if len(sys.argv) > 1 else ""
    recursive = parse_bool(sys.argv[2]) if len(sys.argv) > 2 else False
    if not uri:
        print("Error: uri is required")
        sys.exit(1)
    result = call_proxy("openviking_list", {"uri": uri, "recursive": recursive})
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
