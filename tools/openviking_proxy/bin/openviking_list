#!/usr/bin/env python3
"""List directory contents. Params align with OpenViking fs/ls: uri, simple, recursive, node_limit."""
import argparse
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy, parse_bool


def main():
    ap = argparse.ArgumentParser(description="List OpenViking path (fs/ls).")
    ap.add_argument("uri", nargs="?", default="viking://resources/", help="Viking URI")
    ap.add_argument("--simple", action="store_true", help="Only relative paths")
    ap.add_argument("--recursive", action="store_true", help="List recursively")
    ap.add_argument("--node_limit", type=int, default=None, help="Max nodes (default 1000)")
    args = ap.parse_args()
    params = {"uri": args.uri, "simple": args.simple, "recursive": args.recursive}
    if args.node_limit is not None:
        params["node_limit"] = args.node_limit
    result = call_proxy("openviking_list", params)
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
