#!/usr/bin/env python3
"""Semantic search. Params align with OpenViking search/find: query, target_uri, limit, score_threshold."""
import argparse
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy


def main():
    ap = argparse.ArgumentParser(description="OpenViking find (semantic search).")
    ap.add_argument("query", help="Search query")
    ap.add_argument("target_uri", nargs="?", default="", help="Scope (e.g. viking://resources/)")
    ap.add_argument("--limit", type=int, default=None, help="Max results (default 10)")
    ap.add_argument("--score_threshold", type=float, default=None, help="Min score 0.0-1.0")
    args = ap.parse_args()
    params = {"query": args.query}
    if args.target_uri:
        params["target_uri"] = args.target_uri
    if args.limit is not None:
        params["limit"] = args.limit
    if args.score_threshold is not None:
        params["score_threshold"] = args.score_threshold
    result = call_proxy("openviking_search", params)
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
