#!/usr/bin/env python3
"""Search for user memories in OpenViking."""
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy


def main():
    query = sys.argv[1] if len(sys.argv) > 1 else ""
    if not query:
        print("Error: query is required")
        sys.exit(1)
    result = call_proxy("user_memory_search", {"query": query})
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
