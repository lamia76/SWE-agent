#!/usr/bin/env python3
"""Add resource to OpenViking (index repo). Same role as tools/openviking ov_index_repo."""
import argparse
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy

def main():
    ap = argparse.ArgumentParser(description="Add resource to OpenViking (index).")
    ap.add_argument("path", help="URL or host path (e.g. https://github.com/owner/repo)")
    ap.add_argument("reason", nargs="?", default="", help="Reason/description")
    ap.add_argument("--target", default="", help="Target URI e.g. viking://resources/")
    ap.add_argument("--wait", action="store_true", help="Wait for processing")
    args = ap.parse_args()
    params = {"path": args.path}
    if args.reason:
        params["reason"] = args.reason
    if args.target:
        params["target"] = args.target
    params["wait"] = args.wait
    result = call_proxy("openviking_add_resource", params)
    print(result)
    return 0

if __name__ == "__main__":
    sys.exit(main())
