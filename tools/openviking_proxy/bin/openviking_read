#!/usr/bin/env python3
"""Read content from OpenViking resources."""
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy


def main():
    uri = sys.argv[1] if len(sys.argv) > 1 else ""
    level = sys.argv[2] if len(sys.argv) > 2 else "abstract"
    if not uri:
        print("Error: uri is required")
        sys.exit(1)
    result = call_proxy("openviking_read", {"uri": uri, "level": level})
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
