#!/usr/bin/env python3
"""Find Viking resources using glob patterns."""
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy


def main():
    pattern = sys.argv[1] if len(sys.argv) > 1 else ""
    uri = sys.argv[2] if len(sys.argv) > 2 else ""
    if not pattern:
        print("Error: pattern is required")
        sys.exit(1)
    params = {"pattern": pattern}
    if uri:
        params["uri"] = uri
    result = call_proxy("openviking_glob", params)
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
