#!/usr/bin/env python3
"""Grep by regex. Params align with OpenViking search/grep: uri, pattern, case_insensitive, node_limit."""
import argparse
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy


def main():
    ap = argparse.ArgumentParser(description="OpenViking grep (regex search).")
    ap.add_argument("uri", help="Viking URI to search in")
    ap.add_argument("pattern", help="Regex pattern")
    ap.add_argument("--case-insensitive", action="store_true")
    ap.add_argument("--node_limit", type=int, default=None)
    args = ap.parse_args()
    params = {"uri": args.uri, "pattern": args.pattern, "case_insensitive": args.case_insensitive}
    if args.node_limit is not None:
        params["node_limit"] = args.node_limit
    result = call_proxy("openviking_grep", params)
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
