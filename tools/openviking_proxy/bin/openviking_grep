#!/usr/bin/env python3
"""Search Viking resources using regex patterns (grep)."""
import os
import sys

_bundle_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_bundle_dir, "lib"))
from ov_proxy_client import call_proxy, parse_bool


def main():
    if len(sys.argv) < 3:
        print("Error: uri and pattern are required")
        sys.exit(1)
    uri = sys.argv[1]
    pattern = sys.argv[2]
    case_insensitive = parse_bool(sys.argv[3]) if len(sys.argv) > 3 else False
    result = call_proxy(
        "openviking_grep",
        {"uri": uri, "pattern": pattern, "case_insensitive": case_insensitive},
    )
    print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
