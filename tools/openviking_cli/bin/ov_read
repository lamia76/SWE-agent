#!/usr/bin/env python3
"""
OpenViking tool: ov_read (嵌入式模式，与 tools/openviking 相同)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import new_client, json_print, truncate, handle_exceptions


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Read full content of file (L2)")
    parser.add_argument("uri", help="OpenViking URI (e.g. viking://path/to/file.py)")
    parser.add_argument("--max-chars", type=int, default=16000, help="Max chars (default: 16000)")
    args = parser.parse_args()

    client = new_client()
    try:
        vfs = getattr(client, "viking_fs", client)
        fn = getattr(vfs, "read", None) or getattr(client, "read", None)
        out = fn(args.uri, max_chars=args.max_chars) if fn else vfs.read_content(args.uri, max_chars=args.max_chars)
        text = out.get("content", out) if isinstance(out, dict) else str(out)
        result = truncate(text, args.max_chars)
        json_print({"uri": args.uri, **result})
    finally:
        client.close()


if __name__ == "__main__":
    main()
