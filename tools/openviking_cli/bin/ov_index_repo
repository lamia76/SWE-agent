#!/usr/bin/env python3
"""
OpenViking CLI tool: index_repo (通过 ov add-resource 连接 Server)
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import save_root_uri, json_print, json_error, handle_exceptions, run_ov_cli


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(
        description="Index a repository into OpenViking for semantic search",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "repo_path",
        nargs="?",
        default=".",
        help="Path to repository directory (default: current directory)",
    )
    args = parser.parse_args()
    repo_path = Path(args.repo_path).expanduser().resolve()

    if not repo_path.exists():
        json_error(
            message=f"Repository path does not exist: {repo_path}",
            hint="Please provide a valid path to a repository",
            error_type="FileNotFoundError",
        )
        sys.exit(1)

    code, stdout, stderr = run_ov_cli("add-resource", [str(repo_path)])
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov add-resource failed (exit {code})",
            hint="Check ovcli.conf and OpenViking Server connectivity",
            error_type="IndexingError",
        )
        sys.exit(1)

    try:
        result = json.loads(stdout) if stdout.strip() else {}
    except json.JSONDecodeError:
        result = {}
        if stdout:
            print(stdout)

    root_uri = result.get("root_uri") if isinstance(result, dict) else None
    if root_uri:
        # 优先把 root_uri 写到被索引仓库根目录下的 .openviking_root_uri，
        # 这样后续在该仓库内执行 ov_find/ov_glob/ov_ls 时可以自动读取。
        try:
            save_root_uri(root_uri, path=repo_path / ".openviking_root_uri")
        except Exception:
            # 回退：如果写入指定路径失败，再尝试使用当前工作目录
            save_root_uri(root_uri)
        json_print({
            "root_uri": root_uri,
            "indexed_path": str(repo_path),
            "status": "indexed",
        })
    else:
        json_print({
            "indexed_path": str(repo_path),
            "status": "indexed",
            "raw_output": stdout[:500] if stdout else "(no output)",
        })


if __name__ == "__main__":
    main()
