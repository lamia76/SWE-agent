#!/usr/bin/env python3
"""
OpenViking CLI tool: index_repo

Index a repository into OpenViking (via ov add-resource).
Same logic as tools/openviking, backend uses ov CLI.
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import (
    save_root_uri,
    json_print,
    json_error,
    handle_exceptions,
    run_ov_cli,
)


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(
        description="Index a repository into OpenViking for semantic search",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ov_index_repo .
  ov_index_repo /path/to/repo

After indexing: ov_wait, ov_find, ov_abstract, ov_overview, ov_read
""",
    )
    parser.add_argument(
        "repo_path",
        nargs="?",
        default=".",
        help="Path to repository directory (default: current directory)",
    )
    args = parser.parse_args()
    repo_path = Path(args.repo_path).expanduser().resolve()

    if not repo_path.exists():
        json_error(
            message=f"Repository path does not exist: {repo_path}",
            hint="Please provide a valid path to a repository",
            error_type="FileNotFoundError",
        )
        sys.exit(1)

    code, stdout, stderr = run_ov_cli("add-resource", [str(repo_path)])
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov add-resource failed (exit {code})",
            hint="Check ovcli.conf and network",
            error_type="IndexingError",
        )
        sys.exit(1)

    try:
        result = json.loads(stdout) if stdout.strip() else {}
    except json.JSONDecodeError:
        result = {}
        if stdout:
            print(stdout)

    root_uri = result.get("root_uri") if isinstance(result, dict) else None
    if root_uri:
        save_root_uri(root_uri)
        json_print({
            "root_uri": root_uri,
            "indexed_path": str(repo_path),
            "status": "indexed",
        })
    else:
        json_print({
            "indexed_path": str(repo_path),
            "status": "indexed",
            "raw_output": stdout[:500] if stdout else "(no output)",
        })


if __name__ == "__main__":
    main()
