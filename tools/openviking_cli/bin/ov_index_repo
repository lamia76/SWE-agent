#!/bin/bash
# 仅使用本目录 ovcli.conf；若 benchmark 设置了 OPENVIKING_SERVER_URL 则优先用该 API 地址
bundle_dir="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$(python3 -c "import sys; print(sys.prefix)")/bin:$PATH"
if [ -n "$OPENVIKING_SERVER_URL" ]; then
  OVCLI="$bundle_dir/.ovcli.env.json"
  python3 - "$OVCLI" << 'PY' || true
import json, os, sys
p = sys.argv[1]
c = {"url": os.environ.get("OPENVIKING_SERVER_URL", ""), "api_key": os.environ.get("OPENVIKING_API_KEY") or None, "agent_id": None, "timeout": 120.0, "output": "table"}
open(p, "w").write(json.dumps(c, indent=2))
PY
  [ -f "$OVCLI" ] && export OPENVIKING_CLI_CONFIG_FILE="$OVCLI"
elif [ -f "$bundle_dir/ovcli.conf" ]; then
  export OPENVIKING_CLI_CONFIG_FILE="$bundle_dir/ovcli.conf"
fi
[ -f "$bundle_dir/tls-ca-bundle.pem" ] && export REQUESTS_CA_BUNDLE="$bundle_dir/tls-ca-bundle.pem" && export SSL_CERT_FILE="$bundle_dir/tls-ca-bundle.pem"
if command -v ov &>/dev/null; then
  exec ov add-resource "$@"
elif command -v openviking &>/dev/null; then
  exec openviking add-resource "$@"
else
  exec python3 -m openviking add-resource "$@"
fi
