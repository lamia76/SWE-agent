#!/usr/bin/env python3
"""
OpenViking CLI tool: index_repo (通过 ov add-resource 连接 Server)
"""

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import (
    json_error,
    json_print,
    parse_root_uri_from_ov_table,
    run_ov_cli,
    save_root_uri,
    handle_exceptions,
)


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(
        description="Index a repository into OpenViking for semantic search",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "repo_path",
        nargs="?",
        default=".",
        help="Path to repository directory (default: current directory)",
    )
    default_wait = int(os.environ.get("OPENVIKING_INDEX_WAIT_TIMEOUT", "300"))
    parser.add_argument(
        "--wait-timeout",
        type=int,
        default=default_wait,
        metavar="SEC",
        help=(
            "After add-resource, wait for server queue (ov system wait), seconds "
            f"(default: {default_wait} or OPENVIKING_INDEX_WAIT_TIMEOUT)"
        ),
    )
    parser.add_argument(
        "--no-wait",
        action="store_true",
        help="Skip ov system wait (not recommended: ov_find may return 0 results until processing finishes)",
    )
    args = parser.parse_args()
    repo_path = Path(args.repo_path).expanduser().resolve()

    if not repo_path.exists():
        json_error(
            message=f"Repository path does not exist: {repo_path}",
            hint="Please provide a valid path to a repository",
            error_type="FileNotFoundError",
        )
        sys.exit(1)

    code, stdout, stderr = run_ov_cli("add-resource", [str(repo_path)])
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov add-resource failed (exit {code})",
            hint="Check ovcli.conf and OpenViking Server connectivity",
            error_type="IndexingError",
        )
        sys.exit(1)

    try:
        result = json.loads(stdout) if stdout.strip() else {}
    except json.JSONDecodeError:
        result = {}

    root_uri = result.get("root_uri") if isinstance(result, dict) else None
    if not root_uri and stdout:
        root_uri = parse_root_uri_from_ov_table(stdout)
    if root_uri:
        # 优先把 root_uri 写到被索引仓库根目录下的 .openviking_root_uri，
        # 这样后续在该仓库内执行 ov_find/ov_glob/ov_ls 时可以自动读取。
        try:
            save_root_uri(root_uri, path=repo_path / ".openviking_root_uri")
        except Exception:
            # 回退：如果写入指定路径失败，再尝试使用当前工作目录
            save_root_uri(root_uri)

        skip_wait = args.no_wait or os.environ.get(
            "OPENVIKING_INDEX_SKIP_WAIT", ""
        ).strip().lower() in ("1", "true", "yes")
        wait_payload = None
        if not skip_wait:
            wcode, wout, werr = run_ov_cli(
                "system", ["wait", "--timeout", str(args.wait_timeout)]
            )
            if wcode != 0:
                if werr:
                    sys.stderr.write(werr)
                json_error(
                    message=(
                        f"ov system wait failed (exit {wcode}) after add-resource. "
                        "Resource is registered but background processing may be incomplete."
                    ),
                    hint=(
                        "Increase --wait-timeout, run `ov_wait` later, or retry `ov_find` after a delay. "
                        "To only upload without waiting: --no-wait or OPENVIKING_INDEX_SKIP_WAIT=1."
                    ),
                    error_type="OpenVikingWaitError",
                )
                sys.exit(1)
            wait_payload = {"status": "ready", "timeout_sec": args.wait_timeout}

        out = {
            "root_uri": root_uri,
            "indexed_path": str(repo_path),
            "status": "indexed",
        }
        if wait_payload is not None:
            out["wait"] = wait_payload
        elif skip_wait:
            out["wait"] = {
                "status": "skipped",
                "hint": "Run ov_wait before ov_find if search returns no results.",
            }
        json_print(out)
    else:
        json_print({
            "indexed_path": str(repo_path),
            "status": "indexed",
            "raw_output": stdout[:500] if stdout else "(no output)",
        })


if __name__ == "__main__":
    main()
