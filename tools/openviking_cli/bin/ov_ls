#!/usr/bin/env python3
"""
OpenViking CLI tool: ov_ls (通过 ov ls 连接 Server)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import get_default_uri, json_error, handle_exceptions, run_ov_cli


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="List directory contents at URI")
    parser.add_argument(
        "uri",
        nargs="?",
        default=get_default_uri(),
        help="OpenViking URI (default: .openviking_root_uri if present, else viking://)",
    )
    parser.add_argument("--simple", action="store_true", help="Simple output")
    parser.add_argument("--recursive", action="store_true", help="Recursive list")
    args = parser.parse_args()

    cli_args = [args.uri]
    if args.simple:
        cli_args.append("--simple")
    if args.recursive:
        cli_args.append("--recursive")

    code, stdout, stderr = run_ov_cli("ls", cli_args)
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov ls failed (exit {code})",
            hint="Check URI and ovcli.conf",
            error_type="OpenVikingError",
        )
        sys.exit(1)
    print(stdout, end="")


if __name__ == "__main__":
    main()
