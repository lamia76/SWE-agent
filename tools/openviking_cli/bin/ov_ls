#!/usr/bin/env python3
"""
OpenViking tool: ov_ls (嵌入式模式，与 tools/openviking 相同)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import new_client, json_print, handle_exceptions


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="List directory contents at URI")
    parser.add_argument("uri", nargs="?", default="viking://", help="OpenViking URI (default: viking://)")
    parser.add_argument("--simple", action="store_true", help="Simple output")
    parser.add_argument("--recursive", action="store_true", help="Recursive list")
    args = parser.parse_args()

    client = new_client()
    try:
        vfs = getattr(client, "viking_fs", client)
        kwargs = {}
        if args.simple:
            kwargs["simple"] = True
        if args.recursive:
            kwargs["recursive"] = True
        fn = getattr(vfs, "ls", None) or getattr(client, "ls", None)
        result = (fn(args.uri, **kwargs) if kwargs else fn(args.uri)) if fn else vfs.list_dir(args.uri, **kwargs)
        json_print(result if isinstance(result, (dict, list)) else {"entries": result})
    finally:
        client.close()


if __name__ == "__main__":
    main()
