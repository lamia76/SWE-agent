#!/usr/bin/env python3
"""
OpenViking tool: ov_find (嵌入式模式，与 tools/openviking 相同)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import new_client, json_print, handle_exceptions


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Semantic search in indexed repository")
    parser.add_argument("query", help="Search query")
    parser.add_argument("-k", type=int, default=10, dest="k", help="Result count (default: 10)")
    parser.add_argument("--score-threshold", type=float, dest="threshold", help="Min relevance score (0.0-1.0)")
    args = parser.parse_args()

    client = new_client()
    try:
        vfs = getattr(client, "viking_fs", client)
        kwargs = {"limit": args.k}
        if args.threshold is not None:
            kwargs["score_threshold"] = args.threshold
        if hasattr(vfs, "find"):
            result = vfs.find(args.query, **kwargs)
        else:
            result = client.find(args.query, **kwargs)
        json_print(result if isinstance(result, (dict, list)) else {"results": result})
    finally:
        client.close()


if __name__ == "__main__":
    main()
