#!/usr/bin/env python3
"""
OpenViking CLI tool: ov_find (通过 ov find 连接 Server)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import json_error, handle_exceptions, run_ov_cli


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Semantic search in indexed repository")
    parser.add_argument("query", help="Search query")
    parser.add_argument("-k", type=int, default=10, dest="k", help="Result count (default: 10)")
    parser.add_argument("--score-threshold", type=float, dest="threshold", help="Min relevance score (0.0-1.0)")
    args = parser.parse_args()

    cli_args = [args.query, "--limit", str(args.k)]
    if args.threshold is not None:
        cli_args.extend(["--threshold", str(args.threshold)])

    code, stdout, stderr = run_ov_cli("find", cli_args)
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov find failed (exit {code})",
            hint="Ensure ov_index_repo and ov_wait have been run; check ovcli.conf",
            error_type="OpenVikingError",
        )
        sys.exit(1)
    print(stdout, end="")


if __name__ == "__main__":
    main()
