#!/usr/bin/env python3
"""
OpenViking CLI tool: ov_wait

Wait for OpenViking to finish processing (ov system wait).
Same logic as tools/openviking, backend uses ov CLI.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import json_print, json_error, handle_exceptions, run_ov_cli


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(
        description="Wait for OpenViking processing to complete",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=300,
        help="Max wait time in seconds (default: 300)",
    )
    args = parser.parse_args()

    cli_args = ["--timeout", str(args.timeout)]
    code, stdout, stderr = run_ov_cli("system", ["wait"] + cli_args)
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov system wait failed (exit {code})",
            hint="Check OpenViking Server is running",
            error_type="OpenVikingError",
        )
        sys.exit(1)
    json_print({"status": "ready", "message": "All operations completed successfully"})


if __name__ == "__main__":
    main()
