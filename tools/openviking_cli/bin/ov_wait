#!/usr/bin/env python3
"""
OpenViking tool: ov_wait (嵌入式模式，与 tools/openviking 相同)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import new_client, json_print, handle_exceptions


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Wait for OpenViking processing to complete")
    parser.add_argument("--timeout", type=int, default=300, help="Max wait time in seconds")
    args = parser.parse_args()

    client = new_client()
    try:
        vfs = getattr(client, "viking_fs", client)
        wait_fn = getattr(vfs, "wait", None) or getattr(getattr(client, "system", None), "wait", None)
        if wait_fn:
            wait_fn(timeout=args.timeout)
        else:
            # Fallback: some SDKs use system_wait
            sw = getattr(client, "system_wait", None)
            if sw:
                sw(timeout=args.timeout)
        json_print({"status": "ready", "message": "All operations completed successfully"})
    finally:
        client.close()


if __name__ == "__main__":
    main()
