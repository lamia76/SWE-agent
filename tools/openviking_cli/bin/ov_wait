#!/usr/bin/env python3
"""
OpenViking CLI tool: ov_wait (通过 ov system wait 连接 Server)
"""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import json_print, json_error, handle_exceptions, run_ov_cli


def _default_wait_timeout() -> int:
    """Default seconds for ov system wait; override with OPENVIKING_WAIT_TIMEOUT."""
    raw = os.environ.get("OPENVIKING_WAIT_TIMEOUT", "").strip()
    if not raw:
        return 300
    try:
        return max(1, int(raw, 10))
    except ValueError:
        return 300


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Wait for OpenViking processing to complete")
    parser.add_argument(
        "--timeout",
        type=int,
        default=_default_wait_timeout(),
        help="Max wait time in seconds (default: 300 or OPENVIKING_WAIT_TIMEOUT)",
    )
    args = parser.parse_args()

    cli_args = ["--timeout", str(args.timeout)]
    code, stdout, stderr = run_ov_cli("system", ["wait"] + cli_args)
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)

        # 默认“宽松失败”：只要 ov_wait 本身没挂死，就让上层 agent 继续。
        # 需要严格模式时可设置：OPENVIKING_WAIT_STRICT=1
        strict_raw = os.environ.get("OPENVIKING_WAIT_STRICT", "").strip().lower()
        strict = strict_raw in ("1", "true", "yes")

        err_obj: dict[str, object] = {
            "error": {
                "type": "OpenVikingWaitError",
                "message": f"ov system wait failed (exit {code})",
                "hint": "Check ovcli.conf / OpenViking Server logs / queue processing state",
            }
        }

        if stdout and stdout.strip():
            err_obj["debug"] = {"stdout_preview": stdout.strip()[:2000]}
        if stderr and stderr.strip():
            if "debug" not in err_obj:
                err_obj["debug"] = {}
            err_obj["debug"]["stderr_preview"] = stderr.strip()[:2000]  # type: ignore[index]

        json_print(err_obj)
        sys.exit(1 if strict else 0)

    json_print({"status": "ready", "message": "All operations completed successfully"})


if __name__ == "__main__":
    main()
