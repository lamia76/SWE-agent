#!/usr/bin/env python3
"""
OpenViking CLI tool: ov_overview (通过 ov overview 连接 Server)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import json_error, handle_exceptions, run_ov_cli


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Get L1 overview of file/directory")
    parser.add_argument("uri", help="OpenViking URI (e.g. viking://path/to/file.py)")
    parser.add_argument("--max-chars", type=int, default=8192, help="Max chars (default: 8192)")
    args = parser.parse_args()

    cli_args = [args.uri, "--max-chars", str(args.max_chars)]
    code, stdout, stderr = run_ov_cli("overview", cli_args)
    if code != 0:
        if stderr:
            sys.stderr.write(stderr)
        json_error(
            message=f"ov overview failed (exit {code})",
            hint="Check URI and ovcli.conf",
            error_type="OpenVikingError",
        )
        sys.exit(1)
    print(stdout, end="")


if __name__ == "__main__":
    main()
