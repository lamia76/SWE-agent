#!/usr/bin/env python3
"""
OpenViking tool: ov_glob (嵌入式模式，与 tools/openviking 相同)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))
from ov_common import new_client, json_print, handle_exceptions


@handle_exceptions
def main():
    parser = argparse.ArgumentParser(description="Find files by glob pattern")
    parser.add_argument("pattern", help="Glob pattern (e.g. **/*.py, **/test_*.py)")
    parser.add_argument("--uri", default="viking://", help="Search scope URI (default: viking://)")
    args = parser.parse_args()

    client = new_client()
    try:
        vfs = getattr(client, "viking_fs", client)
        fn = getattr(vfs, "glob", None) or getattr(client, "glob", None)
        result = fn(args.pattern, uri=args.uri) if fn else vfs.glob_search(args.pattern, uri=args.uri)
        json_print(result if isinstance(result, (dict, list)) else {"matches": result})
    finally:
        client.close()


if __name__ == "__main__":
    main()
